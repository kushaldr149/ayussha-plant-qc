# Copy this file to .env and fill in the values.

# First administrator. Used only when the database has no users yet.
# At least 10 characters with upper and lower case letters and a digit. You must change it at first sign-in.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Long random text that signs sign-in cookies. Leave empty to have one generated and stored in the data folder.
SECRET_KEY=

# Set to true once the app is served over HTTPS (cloud server or reverse proxy with a certificate).
COOKIE_SECURE=false

# Hours before a user is signed out.
SESSION_HOURS=12

# Address the app listens on when started with windows\start.bat.
# 127.0.0.1 = this computer only. 0.0.0.0 = also other computers on the plant network.
HOST=127.0.0.1
PORT=8000

# Time zone for dates and timestamps.
TIMEZONE=Asia/Kolkata

# Database. Leave empty to use the built-in SQLite file in the data folder (fine for one plant).
# For PostgreSQL: postgresql+psycopg://user:password@host:5432/plantqc  (and add psycopg[binary] to requirements.txt)
DATABASE_URL=

# Claude API for the AI review (optional). Create a key in the Claude Console.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Most tests and production records sent in one review (each).
AI_MAX_RECORDS=400

# Token for the plant system to post production records to /api/v1/production-records.
# Leave empty to keep the API off. Use a long random value if you turn it on.
PLANT_API_TOKEN=

# Address printed in the QR code on bag labels (for example http://192.168.1.20:8000). Empty = the address used to open the app.
PUBLIC_URL=
